# vi: ft=zsh

# shortcuts (mains)
alias g='git'
alias ll='ls -la'
alias q='exit'

# shortcuts (dev tools)
alias be='bundle exec'
alias nd='next dev'
alias pt='playwright test'
alias sb='supabase'
alias sc='soundcheck warm'
alias tc='tsc --noEmit'
alias vr='vitest run'

# shadowed
alias cat='bat'
alias ls='gls -F --color=auto'
alias ctags="`brew --prefix`/bin/ctags"
alias vi='nvim'
alias vim='nvim'
alias view='nvim -M'

# supply default options
alias bc='bc --mathlib --quiet'
alias ssh='TERM=xterm-256color ssh'
alias tree='LS_COLORS="" tree -C'

# tools
alias json='python -m json.tool' # pretty-print json
alias showpath='echo $PATH | tr ":" "\n"'
alias speedtest='curl -o /dev/null http://speedtest.wdc01.softlayer.com/downloads/test10.zip'
# alias commit-and-submit='lein test && git add . && git commit && git push && exercism submit src/*'
